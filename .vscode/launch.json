{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "Maven: Run (mvn compile exec:java)",
            "request": "launch",
            "command": "mvn compile exec:java",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Java: Run Main (VS Code Debugger)",
            "request": "launch",
            "mainClass": "com.kholifan.Main",
            "projectName": "belajar-sesi1"
        },
        {
            "type": "java",
            "name": "Java: Run Current File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ]
}
